# OPTIONAL — `docker compose up` already works with zero config: docker-compose.yml has the same
# values below baked in as defaults. Copy this file to .env (gitignored) in the project root ONLY
# if you want to override one of them (e.g. point at a shared MongoDB Atlas cluster, or swap the
# Google OAuth client) — a root .env, if present, takes priority over the baked-in defaults.
# Everything else the backend reads (JWT keystore password, SSL keystore password, SBP
# integration secrets) has a safe dev-only default in application.properties and isn't listed here.

# MongoDB connection strings — "mongo" is the docker-compose service name, resolved automatically
# inside the Docker network. Leave these as-is for local Docker Mongo; only change them if you
# want to point the backend at a shared MongoDB Atlas cluster instead.
MONGO_URI=mongodb://mongo:27017/smt
MONGO_URI_NORTHERN=mongodb://mongo:27017/smt_northern
MONGO_URI_SOUTHERN=mongodb://mongo:27017/smt_southern

# Google OAuth 2.0 Web Client ID (Google Cloud Console > APIs & Services > Credentials).
# Must be the SAME client ID as VITE_GOOGLE_CLIENT_ID in frontend/.env — the backend verifies the
# Google ID token's "aud" claim against this value, so the two sides have to match.
# Leave this blank to run without Google sign-in: the app fails that login path closed (a clear
# "not configured" message), not open, so nothing breaks — email/password login still works.
GOOGLE_CLIENT_ID=794584079050-ir6jcdpsb5pe7l9fj7djkveurg8mbieb.apps.googleusercontent.com
