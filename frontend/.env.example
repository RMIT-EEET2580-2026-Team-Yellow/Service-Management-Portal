# OPTIONAL — `docker compose up` already works with zero config: docker-compose.yml bakes this
# same value in as a default for the frontend container. Copy this file to .env (gitignored) here
# ONLY if you want to override it (e.g. swap the Google OAuth client) — a frontend/.env, if
# present, takes priority over the baked-in default.

# Google OAuth Web Client ID (Google Cloud Console > APIs & Services > Credentials).
# Must be the SAME client ID the backend has as GOOGLE_CLIENT_ID (see root .env.example), since
# the backend verifies the token's "aud" against it.
VITE_GOOGLE_CLIENT_ID=794584079050-ir6jcdpsb5pe7l9fj7djkveurg8mbieb.apps.googleusercontent.com
